# Local reference checkouts are kept on disk but not tracked by CPT.
/references/czsc/
/references/wbt/
# 缠论三方实现：2026-09-24 G1 决议移除（与缠论定义冲突，见 architecture.md §7.3）。
# 决议只改了文档、没删盘上的副本，这里补上忽略规则并已于 2026-10-01 清理掉
# 残留的 255 MB；`scripts/fetch_references.sh` 若再次拉取也不会污染 git status。
/references/chanlun-pro/
/references/chanlun.py/
/references/chanlun_pine/

# Python caches and local environments.
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
# pytest 的 JUnit 报告是**本地产物**，取权威测试计数时 `--junit-xml` 生成。
# 名字每次自定（pytest-r27.xml / junit.xml …），按前缀整类挡掉，别指望
# 逐个补（2026-10-01 实测：没这条规则，`git status` 每次都挂一个测试报告）。
pytest-*.xml
junit*.xml
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
# 变体虚拟环境目录（例如迁移残留的 .venv.before-migration）也要盖住：
# graphflow 的忽略名单是**精确目录名**，只认 .venv/venv/env，靠 .gitignore 兜底，
# 否则 `git ls-files --others` 会把整个 site-packages 报出来并被照单索引
# （2026-09-29 实测：581 个文件节点里 401 个是 pip 源码）。
.venv*/
venv/
env/
ENV/

# `env/` 在 gitignore 语义里匹配**任意层级**名为 env 的目录，于是把
# `deploy/env/` 整个吞掉了 —— deploy/README.md 让执行
# `cp deploy/env/cpt-dashboard.env.example ...`，而那个 .example 根本提交不进来，
# fresh clone 连第一步都做不了（2026-09-25 排查 P1-1）。
# 下面三条按顺序重新放行**只有 .example**：
#   ① 先把目录本身从忽略里摘出来（否则里面的文件无法被单独放行）
#   ② 再把目录内容整体排除 ③ 最后只放行 *.example
# ② 不能省：只用 ①②③ 里的 ①③ 会让真实 `deploy/env/cpt-dashboard.env`
# 也变成可提交（将来放了 DB 口令就是泄密）。已在 scratch 仓库实测过两种写法。
!deploy/env/
deploy/env/*
!deploy/env/*.example

# Build artifacts
build/
dist/
*.egg-info/
*.egg

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# OMP runtime logs and stop flags
.omp-logs/

# 本地测试/运行日志：pytest 文本输出、cron 落盘等都是本地产物。
# 2026-10-05 实测：`pytest-output.log`（修 mypy 报错时的临时输出，1.9 KB）
# 被 1d35791 顺手提交进仓。Junit 那两条规则只挡 xml，挡不住 .log。
*.log

# GraphFlow runtime artifacts
.graphflow-cache/
graphflow-out/

# Local secrets and runtime data.
.env
# R58（审计 L15）：只挡精确名 `.env` 挡不住变体/私钥——一次 `git add -A`
# 就可能把私钥或 DSN 带进仓。补齐常见变体（当前仓内无此类文件，纯防御）。
.env.*
!.env.example
*.pem
*.key
*.dbconfig
*.sqlite3
*.pyc

# 沙箱 TLS 代理证书（环境产物，见 known-traps #29）
.git/git-proxy-ca.crt

# 审计期间的临时产物（ruff 报告 / pytest 输出 / 片段文件）；绝不入库
.tmp/
.tmp/
