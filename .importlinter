[importlinter]
root_package = cpt
include_external_packages = True

[importlinter:contract:domain-has-no-third-party-deps]
name = Domain has no third-party deps
type = forbidden
source_modules =
    cpt.domain
forbidden_modules =
    chanlun_pro
    chanlun
    czsc
    requests
    httpx
    sqlalchemy

[importlinter:contract:adapters-do-not-leak-into-domain]
name = Adapters do not leak into domain
type = forbidden
source_modules =
    cpt.domain
forbidden_modules =
    cpt.adapters

# 2026-09-25 审核 P0-2：`cpt/engine/` 整层移除，故原
# `engine-orchestrates-domain-and-storage-only` 契约随之删除（它唯一的作用域就是
# 这个已不存在的包）。`cpt/storage/` 于 2026-10-01（R24）**恢复** —— 见下方 layers
# 契约与 docs/architecture.md §2。
#
# 2026-10-01 补的 `storage-does-not-leak-into-domain`：storage 是「CPT 自有表的读写」，
# 不该被 domain 依赖（domain 只认领域模型，不认表）。

[importlinter:contract:storage-does-not-leak-into-domain]
name = Storage does not leak into domain
type = forbidden
source_modules =
    cpt.domain
forbidden_modules =
    cpt.storage

[importlinter:contract:layers]
name = Layered architecture
type = layers
# ⚠️ import-linter 的 ``layers`` 是**自上而下**写的：第一条是**最高**层，高层可以导入
# 低层，反之不行。web 最高、domain 最低。
# 2026-10-01（R24）把恢复后的 ``cpt.storage`` 放在 application 与 domain 之间：
# application 需要它落库，domain 不该碰它。
layers =
    cpt.web
    cpt.application
    cpt.storage
    cpt.adapters
    cpt.domain

# 关于上面这条契约的三点说明（都是 2026-09-25 补的）：
#
# 1. **它是补的，不是恢复。** 审核报告 §2.1 声称存在一条
#    `domain → engine → application → adapters → storage → web` 的层级契约，
#    实际从来没有过 —— 之前只有上面那两条 `forbidden`。
#
# 2. **审核报告给的方向是整条反的。** 按 import-linter「第一条最高」的写法，它那份
#    清单等于说 `domain` 最高（可导入任何层）、`web` 最低（谁都不能导），与真实依赖
#    方向正好相反。实测（grimp 遍历 cpt 子包的互相导入）真实方向是：
#        cpt.domain      -> []
#        cpt.adapters    -> [domain]
#        cpt.application -> [adapters, domain]
#        cpt.web         -> [adapters, application, domain]
#    即 web > application > adapters > domain —— 所以正确写法就是上面这个顺序。
#
# 3. **照审核报告原样落地会立刻失败**，然后极容易被"顺手放宽"成没用的摆设 ——
#    补这条契约时我第一版就写反了，lint-imports 直接报
#    `cpt.application.replay -> cpt.adapters.*` 违规，正是这个原因。
