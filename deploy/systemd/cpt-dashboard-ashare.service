[Unit]
Description=CPT A-share snapshot batch
Documentation=file:///home/ubuntu/DSH/Chan_Pattern_Trader/scripts/snapshot_a_share_batch.py
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/DSH/Chan_Pattern_Trader
# DB 连接走 ~/.dbconfig（仅 ubuntu 可读 600），脚本里 AShareLocalClient 默认连。
#
# ⚠️ 2026-10-16 起**必须**引 cpt-dashboard.env，理由是一次真实漏报逼出来的：
#    批处理在信号跃迁时会推飞书，而 webhook 只存在于这份 env（属 ubuntu 600）。
#    此前不引它的理由是「避免与 cpt-dashboard.service 形成隐式耦合」——
#    代价却是进程内没有 CPT_FEISHU_WEBHOOK ⇒ 每次跃迁只留一行日志、告警被静默
#    丢弃（实测 2026-10-09~10-15 静默 148 条，含 10-15 那条给用户的
#    `first_sell · 000002 · invalidated`；同时期 web 进程送达 9 条）。
#    ⇒ 这里引它是**在 unit 里明写的依赖**，不是隐藏继承；且缺 webhook 时
#    cpt/adapters/feishu.py 会以 WARNING 记进 journal，不再无声。
#    批处理本身不生成 LLM 文本（只说人话已缓存的），故 env 里其余
#    CPT_LLM_*/CPT_PORT 等对它无实际影响（全仓只有 cpt/llm/config.py:146 读
#    CPT_LLM_ENABLED，而批处理不 import llm 层）。
#    前缀 `-`：env 文件缺失不连带把批处理弄挂（推送照旧失败，但有 WARNING）。
EnvironmentFile=-/home/ubuntu/DSH/Chan_Pattern_Trader/deploy/env/cpt-dashboard.env
ExecStart=/home/ubuntu/DSH/Chan_Pattern_Trader/.venv/bin/python scripts/snapshot_a_share_batch.py --limit 50
# 成功失败退出码 0/1 让 timer 上报：oneshot 不需要 Restart
NoNewPrivileges=true
PrivateTmp=true
# 跑 50 只 × ~1s ≈ 50–120s，留 600s 上限避免连崩拖死
TimeoutStartSec=600
# oneshot 默认 StandardOutput=journal，运维 journalctl -u cpt-dashboard-ashare 即可
