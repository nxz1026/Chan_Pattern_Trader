# CPT Dashboard API 的 systemd 环境文件模板。
#
# 用法：cp deploy/env/cpt-dashboard.env.example deploy/env/cpt-dashboard.env
# （真实的 .env 被 .gitignore 挡住，只提交本 .example）
#
# 下面这些值**与线上实况一致**，照抄即可复现当前生产配置：
#   - CPT_PORT=8010：线上 nginx 的 /cpt/api/ 反代到 127.0.0.1:8010
#     （见 /etc/nginx/sites-enabled/dsh-web）。**不要用 8000** —— 该端口已被
#     另一个项目（Resume-Matcher uvicorn）占用，会绑定失败。
#   - CPT_MODE=realtime：已可用（曾有一段时间 realtime 会拒绝启动，现已接线）。
#   - CPT_POLL_SECONDS=30：与线上 --poll-seconds 30 一致。
CPT_HOST=127.0.0.1
CPT_PORT=8010
CPT_MODE=realtime
CPT_POLL_SECONDS=30
CPT_SYMBOL=BTCUSDT
CPT_INTERVAL=1h

# ---------------------------------------------------------------------------
# 飞书告警通道（R45 补记 —— 这一段原先整个漏了）
#
# ⚠️ **照旧版模版部署 = 静默失去所有告警**，且**不会报任何错**：
#   - `cpt/adapters/feishu.py:45` 从这个变量读 webhook；
#   - `deploy/cron/run-inspection-daily.sh:16` 有一行显式警告
#     「必须加载 env —— 否则 CPT_FEISHU_WEBHOOK 不在环境里，每次巡检都收不到告警」；
#   - 巡检照跑、日志照写，只是**没人在手机上收到东西**。
#
# 真实值只存在于 `deploy/env/cpt-dashboard.env`（被 .gitignore 挡住）。
CPT_FEISHU_WEBHOOK=

# ---------------------------------------------------------------------------
# LLM 服务层（R25）
# ---------------------------------------------------------------------------
# 独立可插拔层：关掉（=0 或不配）**不影响任何核心功能**，看板照常出图。
# 实测 provider：agnes-3.0-flash（OpenAI 兼容）。延迟 320ms–7.4s，所以上层一律
# 走异步队列，不会阻塞 HTTP。
# 免费档、经常 429 —— 队列已做指数退避重入（base×2^n + jitter），
# status 会是 rate_limited 而非 error。
CPT_LLM_ENABLED=0
CPT_LLM_PROVIDER=openai_compatible
CPT_LLM_BASE_URL=https://api.agnes-ai.cn/v1/chat/completions
CPT_LLM_MODEL=agnes-3.0-flash
# ⚠️ 密钥写在这里，**本文件才是入库的那份**（真实的 .env 被 .gitignore 挡住）。
#    所以这里只能是占位符 —— 真 key 写进 deploy/env/cpt-dashboard.env。
CPT_LLM_API_KEY=
CPT_LLM_TIMEOUT=30
# 429 退避重入的最大次数；超过就记 error（rate_limited_exhausted）
CPT_LLM_MAX_ATTEMPTS=5
# 退避 = min(BASE × 2^attempt, MAX) + 0~30% jitter（jitter 防惊群）
CPT_LLM_BACKOFF_BASE=2
CPT_LLM_BACKOFF_MAX=60

# ---------------------------------------------------------------------------
# Wind 通道（R31）
# ---------------------------------------------------------------------------
# node 装在 nvm 下，而 systemd 给服务的 PATH 是
# /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin —— **里面没有 node**。
# 不配这一项，Wind CLI 每次调用都死在 spawn 上，体检会报
# `wind_node_missing: node`（R31 前是 availability() 谎报"可用"）。
# 填**绝对路径**：拼 PATH 不可靠，nvm 会换版本。线上用一条软链固定：
#     ln -sfn ~/.nvm/versions/node/v22.23.2/bin/node ~/.local/bin/node
# 换 nvm 版本后只需重指这条软链，不用动本文件。
# 不配的后果只是「Wind 通道不可用」—— 不影响其它源，探活也仍默认跳过它。
CPT_WIND_NODE=/home/ubuntu/.local/bin/node
# ---------------------------------------------------------------------------
# cron 专用（R57 新增）
# ---------------------------------------------------------------------------
# ⚠️ **只对 cron 作业有意义**，systemd 那边读不到（它只认上面的
#    `EnvironmentFile=` 里列的键，而 systemd 的 EnvironmentFile 会把整个文件
#    灌进环境，所以这几项也会进服务进程，只是服务不用它们）。
#
# R57 之前这里**一个 cron 变量都没有**，于是「保留期在 env 里配」这件事
# 无处可查；更糟的是当时**只有巡检脚本 source 这个文件**，另外三条把
# `CPT_PRUNE_*` 写进来是**无声无效**的。现在五个脚本统一 source，
# 下面的值才会真正生效，且每条脚本的「开始」日志会带 `env=yes|no` 与生效值。
#
# 查当前生效值：`grep 'env=' /home/ubuntu/logs/<作业>.log | tail -1`
#
#: 因子重算的取数源。默认 eastmoney；`wind` 需要合规授权，调用额度真实产生，
#: 且要手动把 `python -m pip install -e ".[wind]"` 装上。
#: CPT_RECOMPUTE_SOURCE=eastmoney
#: 单次运行的调用上限（预算护栏）。
#: CPT_RECOMPUTE_MAX_CALLS=6000
#: 扫描范围：placeholder = 只算有票价的行；source IS NULL = 含数据空洞的行。
#: CPT_RECOMPUTE_SCOPE=placeholder

#: `cpt_run_metric` 的 run 行保留天数（行情类，留够做同比）。
#: CPT_PRUNE_RUN_DAYS=90
#: `cpt_run_metric` 的 inspection 行保留天数（每天状态变化比对的依据，窗口短得多）。
#: CPT_PRUNE_INSPECTION_DAYS=30

#: `cpt_dashboard_run` 的保留天数。7 天 ≈ 2000 轮，远超 ring 的 50 条，
#: 按实测 ~100 kB/行约 170 MB。⚠️ 改这个前先读
#: `cpt/storage/dashboard_run_store.py::prune` 的 docstring —— 清理键是
#: `COALESCE(generated_at, created_at)`，**不是**裸 `generated_at`。
#: CPT_PRUNE_DASHBOARD_RUN_DAYS=7

#: 日报的回看窗口（小时）。作业集中在 02:20~04:30，24 小时足够覆盖「昨天跑没跑」。
#: CPT_REPORT_WINDOW_HOURS=24
