# CPT Dashboard API 的 systemd 环境文件模板。
#
# 用法：cp deploy/env/cpt-dashboard.env.example deploy/env/cpt-dashboard.env
# （真实的 .env 被 .gitignore 挡住，只提交本 .example）
#
# 下面这些值**与线上实况一致**，照抄即可复现当前生产配置：
#   - CPT_PORT=8010：线上 nginx 的 /cpt/api/ 反代到 127.0.0.1:8010
#     （见 /etc/nginx/sites-enabled/dsh-web）。**不要用 8000** —— 该端口已被
#     另一个项目（Resume-Matcher uvicorn）占用，会绑定失败。
#   - CPT_MODE=realtime：已可用（曾有一段时间 realtime 会拒绝启动，现已接线）。
#   - CPT_POLL_SECONDS=30：与线上 --poll-seconds 30 一致。
CPT_HOST=127.0.0.1
CPT_PORT=8010
CPT_MODE=realtime
CPT_POLL_SECONDS=30
CPT_SYMBOL=BTCUSDT
CPT_INTERVAL=1h

# ---------------------------------------------------------------------------
# LLM 服务层（R25）
# ---------------------------------------------------------------------------
# 独立可插拔层：关掉（=0 或不配）**不影响任何核心功能**，看板照常出图。
# 实测 provider：agnes-3.0-flash（OpenAI 兼容）。延迟 320ms–7.4s，所以上层一律
# 走异步队列，不会阻塞 HTTP。
# 免费档、经常 429 —— 队列已做指数退避重入（base×2^n + jitter），
# status 会是 rate_limited 而非 error。
CPT_LLM_ENABLED=0
CPT_LLM_PROVIDER=openai_compatible
CPT_LLM_BASE_URL=https://api.agnes-ai.cn/v1/chat/completions
CPT_LLM_MODEL=agnes-3.0-flash
# ⚠️ 密钥写在这里，**本文件才是入库的那份**（真实的 .env 被 .gitignore 挡住）。
#    所以这里只能是占位符 —— 真 key 写进 deploy/env/cpt-dashboard.env。
CPT_LLM_API_KEY=
CPT_LLM_TIMEOUT=30
# 429 退避重入的最大次数；超过就记 error（rate_limited_exhausted）
CPT_LLM_MAX_ATTEMPTS=5
# 退避 = min(BASE × 2^attempt, MAX) + 0~30% jitter（jitter 防惊群）
CPT_LLM_BACKOFF_BASE=2
CPT_LLM_BACKOFF_MAX=60